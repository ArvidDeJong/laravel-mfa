{
    "name": "darvis/laravel-mfa",
    "description": "Login that survives an outage: magic link, emailed code, text message, authenticator app, recovery codes and password for every Laravel guard, with a resilience check and a controlled emergency mode.",
    "keywords": [
        "laravel",
        "mfa",
        "two-factor",
        "magic-link",
        "otp",
        "totp",
        "sms",
        "multi-guard",
        "passwordless",
        "laravel-boost"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://arviddejong.github.io/laravel-mfa/",
    "authors": [
        {
            "name": "Arvid de Jong",
            "email": "info@arvid.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/ArvidDeJong/laravel-mfa/issues",
        "source": "https://github.com/ArvidDeJong/laravel-mfa"
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "pragmarx/google2fa": "^8.0|^9.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Darvis\\Mfa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darvis\\Mfa\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Darvis\\Mfa\\MfaServiceProvider"
            ],
            "aliases": {
                "Mfa": "Darvis\\Mfa\\Facades\\Mfa"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest tests",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    }
}
