{
    "name": "darvis/laravel-mfa",
    "description": "Login that survives an outage: two factor authentication (2FA), magic link, emailed code, SMS, authenticator app (TOTP), recovery codes and a login firewall with IP allow list and country filter, for every Laravel guard.",
    "keywords": [
        "laravel",
        "mfa",
        "2fa",
        "two-factor",
        "two-factor-authentication",
        "multi-factor-authentication",
        "authentication",
        "login",
        "magic-link",
        "passwordless",
        "otp",
        "totp",
        "authenticator",
        "google-authenticator",
        "recovery-codes",
        "sms",
        "multi-guard",
        "firewall",
        "ip-allowlist",
        "geo-blocking",
        "brute-force",
        "livewire",
        "flux",
        "laravel-boost"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://arviddejong.github.io/laravel-mfa/",
    "authors": [
        {
            "name": "Arvid de Jong",
            "email": "info@arvid.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/ArvidDeJong/laravel-mfa/issues",
        "source": "https://github.com/ArvidDeJong/laravel-mfa"
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "pragmarx/google2fa": "^8.0|^9.0"
    },
    "require-dev": {
        "bacon/bacon-qr-code": "^2.0|^3.0",
        "geoip2/geoip2": "^3.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "livewire/flux": "^2.11",
        "livewire/livewire": "^3.7.4|^4.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "suggest": {
        "bacon/bacon-qr-code": "Draws the QR code on the settings screen (^2.0 or ^3.0); Laravel Fortify already brings it.",
        "geoip2/geoip2": "Required for the \"database\" country driver of the firewall (^3.0).",
        "livewire/flux": "Required for the login, settings, firewall and login log screens (^2.11, the free edition is enough).",
        "livewire/livewire": "Required for the login, settings, firewall and login log screens (^3.7.4 or ^4.0)."
    },
    "autoload": {
        "psr-4": {
            "Darvis\\Mfa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darvis\\Mfa\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Darvis\\Mfa\\MfaServiceProvider"
            ],
            "aliases": {
                "Mfa": "Darvis\\Mfa\\Facades\\Mfa"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest tests",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    }
}
