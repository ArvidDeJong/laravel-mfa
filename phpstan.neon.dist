includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    ignoreErrors:
        # The trait is for host models; nothing in the package itself uses it.
        -
            identifier: trait.unused
            path: src/Concerns/HasMfa.php
        # Larastan cannot resolve views registered under a package namespace,
        # and title() and layout() are macros Livewire adds to the view.
        -
            identifier: argument.type
            message: '#view-string\|null, string given#'
            path: src/Livewire/Concerns/RendersInLayout.php
        -
            identifier: method.notFound
            message: '#Illuminate\\View\\View::(title|layout)\(\)#'
            path: src/Livewire/Concerns/RendersInLayout.php
            # Newer Livewire versions describe the macros themselves.
            reportUnmatched: false
    paths:
        - src
        - database
        - routes
